# Absolute path to your Obsidian dev vault (the folder that contains `.obsidian/`).
# Copy this file to `.env` and set the path. `.env` is gitignored.
#
# TELEGRAM_LLM_DAILY_JOURNALING_DEV_VAULT=/path/to/My vault-Dev
#
# Optional alias (either works if the other is unset):
# OBSIDIAN_DEV_VAULT=/path/to/My vault-Dev

TELEGRAM_LLM_DAILY_JOURNALING_DEV_VAULT=

# Local ASR (npm run asr:serve). Use the same key in the plugin "ASR API key" field.
# MLX_ASR_API_KEY=local-dev-asr-key
# MLX_ASR_HOST=127.0.0.1
# MLX_ASR_PORT=8765
# MLX_ASR_MODEL=Qwen/Qwen3-ASR-0.6B
# HF_TOKEN=hf_xxxxxxx